extends RefCounted
## Showcase mesh builder: triangle soup with per-face "brushes", face-weighted auto-smooth normals
## (soft chamfers, hard creases), multi-surface indexed output and baked vertex ambient occlusion.
## Unlike MeshKit (flat shaded, vertex colour only) this one targets PBR shaders.
##
## Vertex layout consumed by the showcase shaders:
##   COLOR.rgb = albedo (sRGB), COLOR.a = baked AO
##   UV        = primitive coordinates (lathe: x = turn 0..1, y = 0..1 along the profile)
##   UV2.x     = roughness + 2 * metallic      UV2.y = feature id + 0.5 * wear

const WELD: float = 20000.0          # weld grid, 0.05 mm
const WELD_BIAS: int = 1 << 20        # weld keys pack three 21 bit grid coordinates (+-52 m)
const AO_OFFSET: float = 0.0007      # AO rays start this far above the surface
const AO_CONCAVE_MIN: float = 0.003  # a vertex only counts as concave when a neighbour rises this far above its plane (grooves shallower than this are not worth a ray fan)
const CHAMFER_DIAG: float = 0.2      # a lathe segment is a chamfer when both |ds| and |dr| exceed this share

var xf: Transform3D = Transform3D.IDENTITY:
	set(value):
		xf = value
		_xf_shift = value.basis == Basis.IDENTITY
var crease_deg: float = 50.0:
	set(value):
		crease_deg = value
		_crease_cos = cos(deg_to_rad(value))
## Wear given to the chamfer faces generated by the primitives.
var bevel_wear: float = 0.0
## Lathe profile segments shorter than this (and diagonal) count as chamfers.
var chamfer_len: float = 0.0026

var _xf_shift: bool = true            # xf is a pure translation (guns: none): cheaper tri()
var _crease_cos: float = cos(deg_to_rad(50.0))
var _surface: int = 0
var _albedo: Color = Color.WHITE
var _metallic: float = 0.0
var _roughness: float = 0.5
var _wear: float = 0.0
var _feature: int = 0
var _brush: int = -1
var _part: int = 0

var _p: PackedVector3Array = PackedVector3Array()
var _uv: PackedVector2Array = PackedVector2Array()
var _t_brush: PackedInt32Array = PackedInt32Array()
var _t_part: PackedInt32Array = PackedInt32Array()
var _t_cos: PackedFloat32Array = PackedFloat32Array()
var _brushes: Array = []            # [surface, Color, Vector2 uv2]
var _brush_ids: Dictionary = {}


# --- brush state ---------------------------------------------------------------------------------

func surface(index: int) -> void:
	_surface = index
	_brush = -1


func paint(albedo: Color, metallic: float, roughness: float, wear: float = 0.0, feature: int = 0) -> void:
	_albedo = albedo
	_metallic = metallic
	_roughness = roughness
	_wear = wear
	_feature = feature
	_brush = -1


func set_wear(w: float) -> void:
	_wear = w
	_brush = -1


func get_wear() -> float:
	return _wear


func set_feature(f: int) -> void:
	_feature = f
	_brush = -1


## Starts a new smoothing island: vertices are only welded inside one part.
func begin_part() -> void:
	_part += 1


func _brush_id() -> int:
	if _brush >= 0:
		return _brush
	var uv2: Vector2 = Vector2(clampf(_roughness, 0.02, 0.98) + (2.0 if _metallic > 0.5 else 0.0), float(_feature) + clampf(_wear, 0.0, 1.0) * 0.5)
	var key: Array = [_surface, _albedo, uv2]
	if not _brush_ids.has(key):
		_brush_ids[key] = _brushes.size()
		_brushes.append(key)
	_brush = _brush_ids[key]
	return _brush


# --- raw emission --------------------------------------------------------------------------------

## Triangle whose front faces `out` (local direction, only its side matters).
func tri(a: Vector3, b: Vector3, c: Vector3, out: Vector3, ua: Vector2 = Vector2.ZERO, ub: Vector2 = Vector2.ZERO, uc: Vector2 = Vector2.ZERO) -> void:
	var ta: Vector3
	var tb: Vector3
	var tc: Vector3
	var out_w: Vector3
	if _xf_shift:
		ta = a + xf.origin
		tb = b + xf.origin
		tc = c + xf.origin
		out_w = out
	else:
		ta = xf * a
		tb = xf * b
		tc = xf * c
		out_w = xf.basis * out
	var n: Vector3 = (tb - ta).cross(tc - ta)
	if n.length_squared() < 1e-20:
		return
	# Godot front faces are clockwise: (b-a)x(c-a) must point away from the outward side.
	if n.dot(out_w) > 0.0:
		var t: Vector3 = tb
		tb = tc
		tc = t
		var tu: Vector2 = ub
		ub = uc
		uc = tu
	_p.push_back(ta)
	_p.push_back(tb)
	_p.push_back(tc)
	_uv.push_back(ua)
	_uv.push_back(ub)
	_uv.push_back(uc)
	_t_brush.push_back(_brush if _brush >= 0 else _brush_id())
	_t_part.push_back(_part)
	_t_cos.push_back(_crease_cos)


func quad(a: Vector3, b: Vector3, c: Vector3, d: Vector3, out: Vector3, ua: Vector2 = Vector2.ZERO, ub: Vector2 = Vector2.ZERO, uc: Vector2 = Vector2.ZERO, ud: Vector2 = Vector2.ZERO) -> void:
	tri(a, b, c, out, ua, ub, uc)
	tri(a, c, d, out, ua, uc, ud)


func triangle_count() -> int:
	return _t_brush.size()


## All triangles (final space), for the AO ray caster.
func get_faces() -> PackedVector3Array:
	return _p


# --- primitives ----------------------------------------------------------------------------------

## Surface of revolution. `profile` is an Array of Vector3(s, r, knurl): s along `axis` from `origin`,
## r the radius, knurl a depth removed from every odd segment (zig-zag serration).
## Orientation rule: walking along the profile, the outside is where (-dr, ds) points. So an outer
## shell runs with growing s, a rear cap starts on the axis and walks outward, a bore walks back.
## `skip` (k, i) -> bool removes cells (port cut-outs); their rims get walls down to `wall_r`.
func lathe(profile: Array, segs: int, origin: Vector3, axis: Vector3, up_ref: Vector3 = Vector3.UP, skip: Callable = Callable(), wall_r: float = 0.0, new_part: bool = true) -> void:
	if new_part:
		begin_part()
	var ax: Vector3 = axis.normalized()
	var u: Vector3 = up_ref - ax * up_ref.dot(ax)
	if u.length_squared() < 1e-8:
		u = Vector3.RIGHT - ax * ax.x
	u = u.normalized()
	var v: Vector3 = ax.cross(u)
	var n: int = profile.size()
	var total: float = 0.0
	var acc: PackedFloat32Array = PackedFloat32Array()
	acc.push_back(0.0)
	for k in range(1, n):
		total += Vector2(profile[k].x - profile[k - 1].x, profile[k].y - profile[k - 1].y).length()
		acc.push_back(total)
	total = maxf(total, 1e-9)
	var dirs: Array[Vector3] = []
	for i in segs + 1:
		var ang: float = TAU * float(i) / float(segs)
		dirs.append(u * cos(ang) + v * sin(ang))
	var base_wear: float = _wear
	for k in n - 1:
		var p0: Vector3 = profile[k]
		var p1: Vector3 = profile[k + 1]
		var ds: float = p1.x - p0.x
		var dr: float = p1.y - p0.y
		var seg_len: float = sqrt(ds * ds + dr * dr)
		if seg_len < 1e-9:
			continue
		var is_chamfer: bool = seg_len < chamfer_len and absf(ds) > seg_len * CHAMFER_DIAG and absf(dr) > seg_len * CHAMFER_DIAG
		set_wear(maxf(base_wear, bevel_wear) if is_chamfer else base_wear)
		var v0: float = acc[k] / total
		var v1: float = acc[k + 1] / total
		for i in segs:
			if skip.is_valid() and skip.call(k, i):
				continue
			var r00: float = p0.y - (p0.z if i % 2 == 1 else 0.0)
			var r01: float = p0.y - (p0.z if (i + 1) % 2 == 1 else 0.0)
			var r10: float = p1.y - (p1.z if i % 2 == 1 else 0.0)
			var r11: float = p1.y - (p1.z if (i + 1) % 2 == 1 else 0.0)
			var a: Vector3 = origin + ax * p0.x + dirs[i] * r00
			var b: Vector3 = origin + ax * p0.x + dirs[i + 1] * r01
			var c: Vector3 = origin + ax * p1.x + dirs[i + 1] * r11
			var d: Vector3 = origin + ax * p1.x + dirs[i] * r10
			var mid: Vector3 = (dirs[i] + dirs[i + 1]).normalized()
			var out: Vector3 = ax * (-dr) + mid * ds
			var u0: float = float(i) / float(segs)
			var u1: float = float(i + 1) / float(segs)
			quad(a, b, c, d, out, Vector2(u0, v0), Vector2(u1, v0), Vector2(u1, v1), Vector2(u0, v1))
	set_wear(base_wear)
	if not skip.is_valid():
		return
	# walls around the removed cells
	for k in n - 1:
		for i in segs:
			if not skip.call(k, i):
				continue
			var q0: Vector3 = profile[k]
			var q1: Vector3 = profile[k + 1]
			var d0: Vector3 = dirs[i]
			var d1: Vector3 = dirs[i + 1]
			var tangent: Vector3 = (d1 - d0).normalized()
			# previous / next ring
			if k == 0 or not skip.call(k - 1, i):
				quad(origin + ax * q0.x + d0 * q0.y, origin + ax * q0.x + d1 * q0.y, origin + ax * q0.x + d1 * wall_r, origin + ax * q0.x + d0 * wall_r, ax)
			if k == n - 2 or not skip.call(k + 1, i):
				quad(origin + ax * q1.x + d0 * q1.y, origin + ax * q1.x + d1 * q1.y, origin + ax * q1.x + d1 * wall_r, origin + ax * q1.x + d0 * wall_r, -ax)
			# previous / next segment
			if not skip.call(k, (i + segs - 1) % segs):
				quad(origin + ax * q0.x + d0 * q0.y, origin + ax * q1.x + d0 * q1.y, origin + ax * q1.x + d0 * wall_r, origin + ax * q0.x + d0 * wall_r, tangent)
			if not skip.call(k, (i + 1) % segs):
				quad(origin + ax * q0.x + d1 * q0.y, origin + ax * q1.x + d1 * q1.y, origin + ax * q1.x + d1 * wall_r, origin + ax * q0.x + d1 * wall_r, -tangent)


## Box with chamfered edges and corners (44 triangles). Uses `xf`.
func cbox(center: Vector3, size: Vector3, bevel: float, new_part: bool = true) -> void:
	if new_part:
		begin_part()
	var h: Vector3 = size * 0.5
	var b: float = minf(bevel, minf(h.x, minf(h.y, h.z)) * 0.95)
	var base_wear: float = _wear
	var axes: Array[Vector3] = [Vector3.RIGHT, Vector3.UP, Vector3.BACK]
	for a in 3:
		var bi: int = (a + 1) % 3
		var ci: int = (a + 2) % 3
		for sa: float in [-1.0, 1.0]:
			var n: Vector3 = axes[a] * sa
			var eb: Vector3 = axes[bi] * (h[bi] - b)
			var ec: Vector3 = axes[ci] * (h[ci] - b)
			var o: Vector3 = center + axes[a] * (h[a] * sa)
			quad(o - eb - ec, o + eb - ec, o + eb + ec, o - eb + ec, n)
	if b <= 0.0:
		return
	set_wear(maxf(base_wear, bevel_wear))
	for a in 3:
		var bi2: int = (a + 1) % 3
		var ci2: int = (a + 2) % 3
		for sa2: float in [-1.0, 1.0]:
			for sb: float in [-1.0, 1.0]:
				# edge between face (a, sa2) and face (bi2, sb), running along ci2
				var p1: Vector3 = center + axes[a] * (h[a] * sa2) + axes[bi2] * ((h[bi2] - b) * sb)
				var p2: Vector3 = center + axes[a] * ((h[a] - b) * sa2) + axes[bi2] * (h[bi2] * sb)
				var e: Vector3 = axes[ci2] * (h[ci2] - b)
				quad(p1 - e, p1 + e, p2 + e, p2 - e, axes[a] * sa2 + axes[bi2] * sb)
	for sx: float in [-1.0, 1.0]:
		for sy: float in [-1.0, 1.0]:
			for sz: float in [-1.0, 1.0]:
				var c1: Vector3 = center + Vector3(h.x * sx, (h.y - b) * sy, (h.z - b) * sz)
				var c2: Vector3 = center + Vector3((h.x - b) * sx, h.y * sy, (h.z - b) * sz)
				var c3: Vector3 = center + Vector3((h.x - b) * sx, (h.y - b) * sy, h.z * sz)
				tri(c1, c2, c3, Vector3(sx, sy, sz))
	set_wear(base_wear)


## Extrudes a 2D polygon (frame XY plane) along the frame Z axis from d0 to d1, chamfering both rims.
func extrude(poly: PackedVector2Array, frame: Transform3D, d0: float, d1: float, bevel: float, new_part: bool = true) -> void:
	if new_part:
		begin_part()
	var pts: PackedVector2Array = poly.duplicate()
	var area: float = 0.0
	var n: int = pts.size()
	for i in n:
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[(i + 1) % n]
		area += a.x * b.y - b.x * a.y
	if area < 0.0:
		pts.reverse()
	var normals: PackedVector2Array = PackedVector2Array()
	for i in n:
		var e: Vector2 = (pts[(i + 1) % n] - pts[i]).normalized()
		normals.push_back(Vector2(e.y, -e.x))
	var inner: PackedVector2Array = PackedVector2Array()
	for i in n:
		var n0: Vector2 = normals[(i + n - 1) % n]
		var n1: Vector2 = normals[i]
		var miter: Vector2 = (n0 + n1) / maxf(1.0 + n0.dot(n1), 0.35)
		inner.push_back(pts[i] - miter * bevel)
	var base_wear: float = _wear
	var zb: float = bevel if bevel > 0.0 else 0.0
	for i in n:
		var j: int = (i + 1) % n
		var nn: Vector3 = Vector3(normals[i].x, normals[i].y, 0.0)
		var a0: Vector3 = frame * Vector3(pts[i].x, pts[i].y, d0 + zb)
		var b0: Vector3 = frame * Vector3(pts[j].x, pts[j].y, d0 + zb)
		var a1: Vector3 = frame * Vector3(pts[i].x, pts[i].y, d1 - zb)
		var b1: Vector3 = frame * Vector3(pts[j].x, pts[j].y, d1 - zb)
		set_wear(base_wear)
		quad(a0, b0, b1, a1, frame.basis * nn)
		if bevel > 0.0:
			set_wear(maxf(base_wear, bevel_wear))
			var ia0: Vector3 = frame * Vector3(inner[i].x, inner[i].y, d0)
			var ib0: Vector3 = frame * Vector3(inner[j].x, inner[j].y, d0)
			var ia1: Vector3 = frame * Vector3(inner[i].x, inner[i].y, d1)
			var ib1: Vector3 = frame * Vector3(inner[j].x, inner[j].y, d1)
			quad(a0, b0, ib0, ia0, frame.basis * (nn + Vector3(0, 0, -1)))
			quad(a1, b1, ib1, ia1, frame.basis * (nn + Vector3(0, 0, 1)))
	set_wear(base_wear)
	var cap: PackedVector2Array = inner if bevel > 0.0 else pts
	var idx: PackedInt32Array = Geometry2D.triangulate_polygon(cap)
	for t in range(0, idx.size(), 3):
		var q0: Vector2 = cap[idx[t]]
		var q1: Vector2 = cap[idx[t + 1]]
		var q2: Vector2 = cap[idx[t + 2]]
		tri(frame * Vector3(q0.x, q0.y, d0), frame * Vector3(q1.x, q1.y, d0), frame * Vector3(q2.x, q2.y, d0), frame.basis * Vector3(0, 0, -1))
		tri(frame * Vector3(q0.x, q0.y, d1), frame * Vector3(q1.x, q1.y, d1), frame * Vector3(q2.x, q2.y, d1), frame.basis * Vector3(0, 0, 1))


## Sweeps a convex 2D section along a path. `right_ref` fixes the section X axis (kept perpendicular
## to the path). `scales` (optional) scales the section per path point. Closed paths have no caps.
func sweep(path: Array, section: PackedVector2Array, right_ref: Vector3, scales: PackedFloat32Array = PackedFloat32Array(), closed: bool = false, caps: bool = true, new_part: bool = true) -> void:
	if new_part:
		begin_part()
	var n: int = path.size()
	var m: int = section.size()
	var rings: Array = []
	for i in n:
		var prev: Vector3 = path[(i + n - 1) % n] if (closed or i > 0) else path[i]
		var next: Vector3 = path[(i + 1) % n] if (closed or i < n - 1) else path[i]
		var t: Vector3 = (next - prev).normalized()
		var r: Vector3 = right_ref - t * right_ref.dot(t)
		if r.length_squared() < 1e-8:
			r = Vector3.UP - t * t.y
		r = r.normalized()
		var up: Vector3 = r.cross(t)
		var s: float = scales[i] if scales.size() == n else 1.0
		var ring: PackedVector3Array = PackedVector3Array()
		for j in m:
			ring.push_back(path[i] + (r * section[j].x + up * section[j].y) * s)
		rings.append(ring)
	var last: int = n if closed else n - 1
	for i in last:
		var ra: PackedVector3Array = rings[i]
		var rb: PackedVector3Array = rings[(i + 1) % n]
		var ca: Vector3 = path[i]
		var cb: Vector3 = path[(i + 1) % n]
		for j in m:
			var k: int = (j + 1) % m
			var mid: Vector3 = (ra[j] + ra[k] + rb[j] + rb[k]) * 0.25
			quad(ra[j], ra[k], rb[k], rb[j], mid - (ca + cb) * 0.5)
	if caps and not closed:
		_fan(rings[0], path[0], path[0] - path[1])
		_fan(rings[n - 1], path[n - 1], path[n - 1] - path[n - 2])


## Skin over a list of rings (PackedVector3Array, same point count). Outward = away from ring centres.
func loft(rings: Array, cap_start: bool, cap_end: bool, new_part: bool = true) -> void:
	if new_part:
		begin_part()
	var n: int = rings.size()
	var centers: Array[Vector3] = []
	for ring: PackedVector3Array in rings:
		var c: Vector3 = Vector3.ZERO
		for p in ring:
			c += p
		centers.append(c / float(ring.size()))
	for i in n - 1:
		var ra: PackedVector3Array = rings[i]
		var rb: PackedVector3Array = rings[i + 1]
		var m: int = ra.size()
		var cmid: Vector3 = (centers[i] + centers[i + 1]) * 0.5
		for j in m:
			var k: int = (j + 1) % m
			var mid: Vector3 = (ra[j] + ra[k] + rb[j] + rb[k]) * 0.25
			quad(ra[j], ra[k], rb[k], rb[j], mid - cmid)
	if cap_start:
		_fan(rings[0], centers[0], centers[0] - centers[1])
	if cap_end:
		_fan(rings[n - 1], centers[n - 1], centers[n - 1] - centers[n - 2])


func sphere(center: Vector3, radii: Vector3, segs: int, rings: int, new_part: bool = true) -> void:
	if new_part:
		begin_part()
	for r in rings:
		var t0: float = PI * float(r) / float(rings)
		var t1: float = PI * float(r + 1) / float(rings)
		for s in segs:
			var a0: float = TAU * float(s) / float(segs)
			var a1: float = TAU * float(s + 1) / float(segs)
			var p00: Vector3 = _sph(t0, a0)
			var p01: Vector3 = _sph(t0, a1)
			var p10: Vector3 = _sph(t1, a0)
			var p11: Vector3 = _sph(t1, a1)
			var out: Vector3 = (p00 + p01 + p10 + p11) * radii
			quad(center + p00 * radii, center + p01 * radii, center + p11 * radii, center + p10 * radii, out)


static func _sph(theta: float, phi: float) -> Vector3:
	return Vector3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi))


func _fan(ring: PackedVector3Array, center: Vector3, out: Vector3) -> void:
	var m: int = ring.size()
	for j in m:
		tri(center, ring[j], ring[(j + 1) % m], out)


# --- section helpers -----------------------------------------------------------------------------

static func circle_section(radius: float, segs: int) -> PackedVector2Array:
	var out: PackedVector2Array = PackedVector2Array()
	for i in segs:
		var a: float = TAU * float(i) / float(segs)
		out.push_back(Vector2(cos(a), sin(a)) * radius)
	return out


## Rectangle w x h with chamfered corners (8 points).
static func rect_section(w: float, h: float, chamfer: float) -> PackedVector2Array:
	var x: float = w * 0.5
	var y: float = h * 0.5
	var c: float = minf(chamfer, minf(x, y) * 0.9)
	return PackedVector2Array([
		Vector2(x, -y + c), Vector2(x, y - c), Vector2(x - c, y), Vector2(-x + c, y),
		Vector2(-x, y - c), Vector2(-x, -y + c), Vector2(-x + c, -y), Vector2(x - c, -y)])


## Stock / forend cross-section at station s (gun space: x right, y up, z = -s). `t` holds PackedVector2Array
## curves over s: top, bot, wid (half width), widest (share of height from the top where it is widest),
## exp_top, exp_bot (superellipse exponents). `scale` shrinks the ring around its widest point (tip rounding);
## `at_s` places the ring at another station.
static func section_ring(t: Dictionary, s: float, points: int, scale: float = 1.0, at_s: float = -1.0) -> PackedVector3Array:
	var top: float = pchip(t["top"], s)
	var bot: float = pchip(t["bot"], s)
	var w: float = pchip(t["wid"], s)
	var ym: float = lerpf(top, bot, pchip(t["widest"], s))
	var nt: float = pchip(t["exp_top"], s)
	var nb: float = pchip(t["exp_bot"], s)
	var zs: float = s if at_s < 0.0 else at_s
	var out: PackedVector3Array = PackedVector3Array()
	for i in points:
		var a: float = TAU * float(i) / float(points)
		var c: float = cos(a)
		var sn: float = sin(a)
		var e: float = 2.0 / (nt if sn >= 0.0 else nb)
		var x: float = w * signf(c) * pow(absf(c), e)
		var y: float = ym + (top - ym if sn >= 0.0 else ym - bot) * signf(sn) * pow(absf(sn), e)
		out.push_back(Vector3(x * scale, ym + (y - ym) * scale, -zs))
	return out


## Array of [s, value] pairs -> PackedVector2Array.
static func curve(table: Array) -> PackedVector2Array:
	var out: PackedVector2Array = PackedVector2Array()
	for k: Array in table:
		out.push_back(Vector2(k[0], k[1]))
	return out


## Monotone cubic (PCHIP) through keys sorted by x: no overshoot between keys.
static func pchip(keys: PackedVector2Array, x: float) -> float:
	var n: int = keys.size()
	if x <= keys[0].x:
		return keys[0].y
	if x >= keys[n - 1].x:
		return keys[n - 1].y
	var i: int = 0
	while i < n - 2 and x > keys[i + 1].x:
		i += 1
	var h: float = keys[i + 1].x - keys[i].x
	var d: float = (keys[i + 1].y - keys[i].y) / h
	var m0: float = _pchip_slope(keys, i)
	var m1: float = _pchip_slope(keys, i + 1)
	var t: float = (x - keys[i].x) / h
	var t2: float = t * t
	var t3: float = t2 * t
	if d == 0.0:
		return keys[i].y
	return (2.0 * t3 - 3.0 * t2 + 1.0) * keys[i].y + (t3 - 2.0 * t2 + t) * h * m0 + (-2.0 * t3 + 3.0 * t2) * keys[i + 1].y + (t3 - t2) * h * m1


static func _pchip_slope(keys: PackedVector2Array, i: int) -> float:
	var n: int = keys.size()
	if i == 0:
		return (keys[1].y - keys[0].y) / (keys[1].x - keys[0].x)
	if i == n - 1:
		return (keys[n - 1].y - keys[n - 2].y) / (keys[n - 1].x - keys[n - 2].x)
	var h0: float = keys[i].x - keys[i - 1].x
	var h1: float = keys[i + 1].x - keys[i].x
	var d0: float = (keys[i].y - keys[i - 1].y) / h0
	var d1: float = (keys[i + 1].y - keys[i].y) / h1
	if d0 * d1 <= 0.0:
		return 0.0
	var w0: float = 2.0 * h1 + h0
	var w1: float = h1 + 2.0 * h0
	return (w0 + w1) / (w0 / d0 + w1 / d1)


## Catmull-Rom resampling of an open polyline.
static func smooth_path(points: Array, steps: int) -> Array:
	var out: Array = []
	var n: int = points.size()
	for i in n - 1:
		var p0: Vector3 = points[maxi(i - 1, 0)]
		var p1: Vector3 = points[i]
		var p2: Vector3 = points[i + 1]
		var p3: Vector3 = points[mini(i + 2, n - 1)]
		for s in steps:
			var t: float = float(s) / float(steps)
			out.append(p1.cubic_interpolate(p2, p0, p3, t))
	out.append(points[n - 1])
	return out


# --- build ---------------------------------------------------------------------------------------

## Returns { "surfaces": { index: {pos, nrm, uv, uv2, col, idx} } }. Normals: every corner averages
## the faces of its part that meet at that point within the crease angle, weighted by area x corner
## angle, so large flats stay flat and the small chamfers carry the whole gradient.
func build() -> Dictionary:
	var nt: int = _t_brush.size()
	var fn: PackedVector3Array = PackedVector3Array()
	var fw: PackedFloat32Array = PackedFloat32Array()   # per corner: area * angle
	fn.resize(nt)
	fw.resize(nt * 3)
	var weld: Dictionary = {}
	var corner_weld: PackedInt32Array = PackedInt32Array()
	corner_weld.resize(nt * 3)
	var adj: Array = []          # per weld id: Array[int] of corner indices (Array, not Packed: shared by reference)
	var weld_part: int = -1
	for t in nt:
		var tb: int = t * 3
		var a: Vector3 = _p[tb]
		var b: Vector3 = _p[tb + 1]
		var c: Vector3 = _p[tb + 2]
		var cr: Vector3 = (b - a).cross(c - a)
		var area: float = cr.length() * 0.5
		fn[t] = -cr.normalized()
		# triangles are emitted part by part: welding only needs a table per part
		if _t_part[t] != weld_part:
			weld_part = _t_part[t]
			weld = {}
		fw[tb] = area * maxf((b - a).angle_to(c - a), 1e-4)
		fw[tb + 1] = area * maxf((c - b).angle_to(a - b), 1e-4)
		fw[tb + 2] = area * maxf((a - c).angle_to(b - c), 1e-4)
		for k in 3:
			var p: Vector3 = _p[tb + k]
			var key: int = ((roundi(p.x * WELD) + WELD_BIAS) << 42) | ((roundi(p.y * WELD) + WELD_BIAS) << 21) | (roundi(p.z * WELD) + WELD_BIAS)
			var id: int = weld.get(key, -1)
			if id < 0:
				id = adj.size()
				weld[key] = id
				adj.append([tb + k])
			else:
				(adj[id] as Array).append(tb + k)
			corner_weld[tb + k] = id
	# Weld points whose faces all lie within the crease angle of each other (smooth surfaces, flat panels) give
	# every corner the same normal: one pass per point instead of one per corner.
	var nw: int = adj.size()
	var w_nrm: PackedVector3Array = PackedVector3Array()
	var w_state: PackedByteArray = PackedByteArray()     # 0 = per corner (creased), 1 = shared normal, 2 = shared + concave
	var w_nq: PackedInt64Array = PackedInt64Array()
	w_nrm.resize(nw)
	w_nq.resize(nw)
	w_state.resize(nw)
	for id in nw:
		var corners: Array = adj[id]
		var sum: Vector3 = Vector3.ZERO
		var cos_max: float = -1.0
		for cj: int in corners:
			@warning_ignore("integer_division")
			var tj: int = cj / 3
			sum += fn[tj] * fw[cj]
			cos_max = maxf(cos_max, _t_cos[tj])
		if sum.length_squared() <= 0.0:
			continue
		var m: Vector3 = sum.normalized()
		# every face within half the (smallest) crease angle of the mean: any two are within the crease angle
		var need: float = sqrt(maxf(1.0 + cos_max, 0.0) * 0.5)
		var flat: bool = true
		var ok: bool = true
		for cj: int in corners:
			@warning_ignore("integer_division")
			var d: float = fn[cj / 3].dot(m)
			if d < need:
				ok = false
				break
			if d < 0.9999:
				flat = false
		if not ok:
			continue
		w_nrm[id] = m
		w_nq[id] = _quantize_normal(m)
		w_state[id] = 1
		if not flat:
			var pw: Vector3 = _p[(corners[0] as int)]
			if _concave(corners, fn, m, pw) == 1:
				w_state[id] = 2
	var surface_ids: Array = []
	for brush: Array in _brushes:
		if not surface_ids.has(brush[0]):
			surface_ids.append(brush[0])
	surface_ids.sort()
	var surfaces: Dictionary = {}
	var tris_of: Dictionary = {}          # surface id -> triangles painted on it
	for si: int in surface_ids:
		tris_of[si] = []
	for t in nt:
		(tris_of[(_brushes[_t_brush[t]] as Array)[0]] as Array).append(t)
	for si: int in surface_ids:
		var pos: PackedVector3Array = PackedVector3Array()
		var nrms: PackedVector3Array = PackedVector3Array()
		var uvs: PackedVector2Array = PackedVector2Array()
		var uv2s: PackedVector2Array = PackedVector2Array()
		var cols: PackedColorArray = PackedColorArray()
		var conc: PackedByteArray = PackedByteArray()
		var idx: PackedInt32Array = PackedInt32Array()
		var lookup: Dictionary = {}
		for t: int in tris_of[si]:
			var bi: int = _t_brush[t]
			var brush: Array = _brushes[bi]
			var nf: Vector3 = fn[t]
			var cmin: float = _t_cos[t]
			for k in 3:
				var ci: int = t * 3 + k
				var wid: int = corner_weld[ci]
				var nrm: Vector3
				var nq: int
				var is_conc: int = -1
				var st: int = w_state[wid]
				if st != 0:
					nrm = w_nrm[wid]
					nq = w_nq[wid]
					is_conc = st - 1
				else:
					var sum: Vector3 = Vector3.ZERO
					for cj: int in adj[wid]:
						@warning_ignore("integer_division")
						var tj: int = cj / 3
						if fn[tj].dot(nf) >= cmin:
							sum += fn[tj] * fw[cj]
					nrm = sum.normalized() if sum.length_squared() > 0.0 else nf
					nq = _quantize_normal(nrm)
				var uv: Vector2 = _uv[ci]
				var uq: int = 0 if uv == Vector2.ZERO else roundi(uv.x * 8192.0) * 65536 + roundi(uv.y * 8192.0)
				var vkey: Vector4i = Vector4i(wid, bi, nq, uq)
				var vi: int = lookup.get(vkey, -1)
				if vi < 0:
					vi = pos.size()
					lookup[vkey] = vi
					pos.push_back(_p[ci])
					nrms.push_back(nrm)
					uvs.push_back(uv)
					uv2s.push_back(brush[2])
					cols.push_back(brush[1])
					conc.push_back(is_conc if is_conc >= 0 else _concave(adj[wid], fn, nf, _p[ci]))
				idx.push_back(vi)
		surfaces[si] = {"pos": pos, "nrm": nrms, "uv": uvs, "uv2": uv2s, "col": cols, "idx": idx, "conc": conc}
	return {"surfaces": surfaces}


static func _quantize_normal(n: Vector3) -> int:
	return (roundi(n.x * 400.0) + 512) * 1048576 + (roundi(n.y * 400.0) + 512) * 1024 + roundi(n.z * 400.0) + 512


## 1 when a triangle around the corner (`corners` = every corner welded at that point) pokes above the face plane
## (`nf` at `p`) by more than AO_CONCAVE_MIN: the only way the neighbouring triangles can shade this vertex.
## Convex and flat vertices cannot be occluded by their own surface, so bake_ao skips them.
func _concave(corners: Array, fn: PackedVector3Array, nf: Vector3, p: Vector3) -> int:
	for cj: int in corners:
		@warning_ignore("integer_division")
		var tj: int = cj / 3
		if fn[tj].dot(nf) > 0.9999:
			continue
		var b: int = tj * 3
		if (_p[b] - p).dot(nf) > AO_CONCAVE_MIN or (_p[b + 1] - p).dot(nf) > AO_CONCAVE_MIN or (_p[b + 2] - p).dot(nf) > AO_CONCAVE_MIN:
			return 1
	return 0


## Bakes ambient occlusion into COLOR.a of the vertices of `built` by casting short rays against `occluders`
## (a TriangleMesh holding the triangles that may shade the model). Rays are only cast where something can
## occlude: vertices whose own surface is concave (`conc` from build()) and vertices inside `near` (the volume
## within `radius` of the occluders that are not part of the model itself, e.g. the gun under the hands).
## Everything else is open: AO 1.
static func bake_ao(built: Dictionary, occluders: TriangleMesh, rays: int, radius: float, strength: float, floor_ao: float, near: AABB = AABB()) -> void:
	var dirs: PackedVector3Array = PackedVector3Array()
	for i in rays:
		# cosine weighted hemisphere around +Y (Fibonacci spiral)
		var u: float = (float(i) + 0.5) / float(rays)
		var phi: float = float(i) * 2.399963
		var r: float = sqrt(u)
		dirs.push_back(Vector3(r * cos(phi), sqrt(1.0 - u), r * sin(phi)))
	var use_near: bool = near.has_surface()
	var inv_rays: float = 1.0 / float(rays)
	var inv_radius: float = 1.0 / radius
	var surfaces: Dictionary = built["surfaces"]
	for si: int in surfaces:
		var sd: Dictionary = surfaces[si]
		var pos: PackedVector3Array = sd["pos"]
		var nrm: PackedVector3Array = sd["nrm"]
		var col: PackedColorArray = sd["col"]
		var conc: PackedByteArray = sd["conc"]
		for i in pos.size():
			if conc[i] == 0 and not (use_near and near.has_point(pos[i])):
				continue
			var n: Vector3 = nrm[i]
			var t: Vector3 = n.cross(Vector3.RIGHT if absf(n.x) < 0.8 else Vector3.UP).normalized()
			var basis: Basis = Basis(t, n, n.cross(t))
			var o: Vector3 = pos[i] + n * AO_OFFSET
			var occ: float = 0.0
			for d in dirs:
				var w: Vector3 = basis * d
				var hit: Dictionary = occluders.intersect_segment(o, o + w * radius)
				if not hit.is_empty():
					occ += 1.0 - (hit["position"] as Vector3).distance_to(o) * inv_radius
			var c: Color = col[i]
			c.a = clampf(1.0 - strength * occ * inv_rays, floor_ao, 1.0)
			col[i] = c
		sd["col"] = col


## Appends the surfaces of `built` to `mesh` in ascending surface order, one material each.
static func commit(built: Dictionary, mesh: ArrayMesh, materials: Dictionary) -> void:
	var surfaces: Dictionary = built["surfaces"]
	var keys: Array = surfaces.keys()
	keys.sort()
	for si: int in keys:
		var sd: Dictionary = surfaces[si]
		var arrays: Array = []
		arrays.resize(Mesh.ARRAY_MAX)
		arrays[Mesh.ARRAY_VERTEX] = sd["pos"]
		arrays[Mesh.ARRAY_NORMAL] = sd["nrm"]
		arrays[Mesh.ARRAY_TEX_UV] = sd["uv"]
		arrays[Mesh.ARRAY_TEX_UV2] = sd["uv2"]
		arrays[Mesh.ARRAY_COLOR] = sd["col"]
		arrays[Mesh.ARRAY_INDEX] = sd["idx"]
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		mesh.surface_set_material(mesh.get_surface_count() - 1, materials.get(si))
